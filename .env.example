# LATAM Growth Dashboard: environment variables template
# Copy to .env and fill in real values. Never commit .env (it is in .gitignore).
# Every value here is intentionally blank or an example. Defaults in brackets are what the code uses when the variable is unset.

# ─── Injected by the runtime: do NOT set these in .env ───────────────────────
# PORT=            HTTP port (assigned automatically)
# DATABASE_URL=    mysql://user:pass@host:port/db   (or DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME)
# BASE_PATH=       public URL prefix

# ─── Dashboard access ─────────────────────────────────────────────────────────
# Comma-separated users, format user:password[:role]  role = admin | read | ads
DASH_USERS=
# Secret used to sign session cookies [derived from DASH_USERS if empty; set your own in production]
SESSION_SECRET=
# Session lifetime in days [30]
SESSION_DAYS=
# Optional extra team code required at login
TEAM_CODE=

# ─── Data loading ─────────────────────────────────────────────────────────────
# Shared key for machine loads: POST api/ingest with header x-ingest-key (daily routine)
INGEST_KEY=
# Automatic connector sync interval in hours (empty/0 = manual only)
SYNC_EVERY_HOURS=
# Launch date used by connectors to split pre/post launch [2026-10-01]
LAUNCH_DATE=
# Comma-separated internal email domains excluded from metrics [think4ever.com]
INTERNAL_DOMAINS=
# Additional internal-company names used in HubSpot and PostHog [think4ever,moadbus].
INTERNAL_COMPANIES=
# Comma-separated hosts that are measured: GA4 reports, PostHog events/people and HubSpot sign-ups
# are limited to these. HubSpot traffic cannot be filtered and is labelled "todo el sitio".
# [think4ever.com,www.think4ever.com,go.think4ever.com,portal.think4ever.com]
SITE_HOSTS=

# ─── Ad loader ────────────────────────────────────────────────────────────────
# 1 = really send ads to the platforms; anything else = test mode (payloads built, not sent)
AD_LOADER_LIVE=
# Max daily budget per ad in USD [50]
AD_BUDGET_CAP_USD=

# ─── HubSpot ──────────────────────────────────────────────────────────────────
HUBSPOT_TOKEN=
# Optional comma-separated list of the custom contact fields created from docs/utm-measurement.md.
# Order matters: FIRST create these contact properties in HubSpot (single-line text, exact internal
# names) and add them as hidden fields to the LATAM form; THEN set this variable. If a listed
# property does not exist, the connector retries without them and logs a warning.
# Full list: utm_source,utm_medium,utm_campaign,utm_content,utm_term,landing_page,first_utm_source,first_utm_medium,first_utm_campaign,first_utm_content
HUBSPOT_UTM_PROPERTIES=

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
GA4_PROPERTY_ID=
# Full service-account JSON on one line
GA4_SERVICE_ACCOUNT=

# ─── PostHog ──────────────────────────────────────────────────────────────────
# Required (all three) to connect PostHog.
# API host of the PostHog cloud region, e.g. https://us.posthog.com (or https://eu.posthog.com)
POSTHOG_HOST=
# Numeric project ID (PostHog -> Settings -> Project)
POSTHOG_PROJECT_ID=
# Personal API key with query (read) access to that project
POSTHOG_API_KEY=
# Sign-ups by country use the person property 'country' sent by the portal, then $geoip_country.
# Sign-ups by campaign/persona use utm_* sent by the portal in posthog.identify, then $initial_utm_*.
# Optional. The PostHog Action used as the temporary activation proxy.
# Default: 407660 (“Proyecto creado (clic)”). This is a click proxy, not a
# confirmed backend project_created event.
POSTHOG_ACTIVATION_ACTION_ID=407660
# The confirmed product event emitted by the backend [project_created]
POSTHOG_PROJECT_CREATED_EVENT=project_created
# Keep blank/0 until Product has deployed and verified that event. Set to 1
# afterwards; the detailed UTM aggregation can be expensive on larger projects.
POSTHOG_PROJECT_CREATED_ENABLED=0

# ─── Microsoft Clarity ────────────────────────────────────────────────────────
CLARITY_TOKEN=

# ─── Meta (Facebook / Instagram) Ads ─────────────────────────────────────────
META_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# [v23.0]
META_API_VERSION=

# ─── LinkedIn ─────────────────────────────────────────────────────────────────
# Either LINKEDIN_TOKEN, or REFRESH_TOKEN + CLIENT_ID + CLIENT_SECRET
LINKEDIN_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# [129864039]
LINKEDIN_ORG_ID=
LINKEDIN_AD_ACCOUNT_ID=
# YYYYMM [current month]
LINKEDIN_API_VERSION=

# ─── Google Ads ───────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Manager (MCC) account id, only if accessing through one
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# [v21]
GOOGLE_ADS_API_VERSION=
